# Copy to .env (never commit .env). `voice-engine serve` reads it automatically.

# ---- AI gateway: any OpenAI-compatible /chat/completions endpoint ----
# Option A: DeepSeek on Alibaba Bailian through a gateway (same model as the reference project)
LLM_BASE_URL=https://your-gateway.example/v1
LLM_MODEL=bailian/deepseek-v4.1-flash
LLM_API_KEY=
LLM_THINKING_PARAM=enable_thinking

# Option B: local vLLM on the AMD GPU (see docs/LLM_GATEWAY.md)
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_API_KEY=EMPTY
# LLM_THINKING_PARAM=chat_template_kwargs

# ---- Cost and abuse limits (failed attempts count) ----
LLM_DAILY_CALL_LIMIT=200
LLM_PER_CLIENT_PER_MIN=8
LLM_TIMEOUT_S=35
VOICE_DB_PATH=./data/voice.sqlite

# ---- Audio backend: auto | cpu | rocm ----
VOICE_BACKEND=auto

# ---- Optional fallback: Claude through the Anthropic API (used only if LLM_* is not set) ----
# ANTHROPIC_API_KEY=
